DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_tracker
PORT=4000

# Set to 'production' for any real deployment.
NODE_ENV=development

# Local development only: skips authentication entirely and treats every request as the
# seeded dev user — handy for local dev and automated UI testing, never for an install
# anyone else can reach. Only takes effect when NODE_ENV is not 'production'; leaving it
# unset (the default) keeps normal password login active.
ENABLE_DEV_AUTH_BYPASS=false

# Signing key for session tokens (required). Must be >= 32 chars — the API refuses
# to start issuing/validating sessions without it rather than falling back to a
# guessable default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Set to true when the app is served over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=false

# Set to true ONLY when the frontend is on a different domain than this API
# (e.g. frontend on Vercel, API on Render) — a split deployment where the
# browser treats every request as cross-site. Without this, the session
# cookie is `SameSite=Lax`, which browsers refuse to attach to a cross-site
# fetch/XHR call at all — every API request would still get a response, just
# always a 401, which looks exactly like "login is broken" with nothing in
# the network tab pointing at the cookie. Requires COOKIE_SECURE=true (the
# API refuses to start otherwise — see server.ts). Leave false for a
# same-origin deployment (frontend and API behind one domain/reverse proxy).
CROSS_ORIGIN_COOKIES=false

# Comma-separated origins allowed to call the API with credentials. Never `*` —
# the session cookie travels on credentialed requests, which browsers refuse
# to allow against a wildcard origin anyway. FRONTEND_URL works too (same
# comma-separated format) if that's the name your hosting platform's deploy
# guide uses; set either one, or both.
WEB_ORIGIN=http://localhost:5173,http://localhost:5174
# FRONTEND_URL=https://your-app.vercel.app

# Optional: where `npm run backup` writes snapshot files. Point this at a folder that syncs
# elsewhere (OneDrive, Google Drive) so backups survive more than a single-disk failure.
# Defaults to a folder next to the embedded Postgres data if unset.
# FINANCE_BACKUP_DIR=C:\Users\you\OneDrive\finance-backups
